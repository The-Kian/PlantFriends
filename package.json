    "@react-navigation/native-stack": "^7.8.5",
    "@react-navigation/stack": "^7.6.11",
    "@reduxjs/toolkit": "^2.6.1",
    "expo": "^55.0.32",
    "expo-apple-authentication": "~55.0.17",
    "expo-build-properties": "~55.0.18",
    "expo-crypto": "~55.0.19",
    "expo-dev-client": "~55.0.41",
    "expo-font": "~55.0.6",
    "expo-notifications": "~55.0.27",
    "expo-splash-screen": "~55.0.25",
    "expo-system-ui": "~55.0.22",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-uuid": "^2.0.2",
    "react-native-worklets": "0.7.4",
    "react-redux": "^9.2.0"
