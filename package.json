    "@types/react": "~19.2.17",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~55.0.23",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~55.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^28.9.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "jest": "^29.2.1",
    "jest-expo": "^55.0.22",
    "prettier": "^3.3.0",
    "react-test-renderer": "19.2.0",
    "typescript": "^5.9.3"
