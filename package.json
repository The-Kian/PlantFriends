      "browserslist@<5": "^4.28.7",
      "baseline-browser-mapping@>=2 <3": "^2.11.0",
      "@xmldom/xmldom@>=0.7 <0.9": "^0.8.15",
      "@xmldom/xmldom@>=0.9.0-0 <0.10": "^0.9.12",
      "@grpc/grpc-js@<2": "^1.13.6",
      "source-map-js@<2": "^1.2.2",
      "compression@<2": "^1.8.2",
      "shell-quote@<2": "^1.11.0",
      "node-forge@<2": "^1.4.3"
