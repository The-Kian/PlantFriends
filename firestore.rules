rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profiles: each user can read and write only their own profile,
    // only the keys in clientUserKeys, and never delete it. `householdId` is
    // special: Cloud Functions change that (joining, leaving,
    // being removed). The one thing the app may do is point it at a household
    // it set up on its own and is the only member of: that is first-time
    // setup (src/helpers/household/setupHousehold.ts).
    function ownSoloHousehold(uid, hid) {
      return hid is string
        && get(/databases/$(database)/documents/Households/$(hid)).data.memberIds == [uid]
        && get(/databases/$(database)/documents/Households/$(hid)).data.createdBy == uid;
    }

    // The only profile keys the app writes (AuthProvider, setupHousehold,
    // setNotificationPref, PushRegistration). Anything else is server-only.
    function clientUserKeys() {
      return ['displayName', 'email', 'householdId', 'notificationPrefs',
              'timeZone', 'plantsMigratedAt'];
    }

    // Deleting the profile is done by the deleteAccount Cloud Function.
    match /Users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(clientUserKeys())
        && (!('householdId' in request.resource.data)
          || ownSoloHousehold(uid, request.resource.data.householdId));
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(clientUserKeys())
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['householdId'])
          || ownSoloHousehold(uid, request.resource.data.get('householdId', null)));
      allow delete: if false;
    }

    // Devices registered for push notifications. The doc ID is the Expo push
    // token. Cloud Functions read these to send pushes.
    match /Users/{uid}/Devices/{token} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // User plants from older builds, before households. Kept for one release
    // so the app can migrate them; remove once nobody runs an old build.
    match /Users/{uid}/UserPlants/{userPlantId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Households: housemates who share one set of plants.
    // See docs/household-sharing-plan.md.
    function householdMemberIds(hid) {
      return get(/databases/$(database)/documents/Households/$(hid)).data.memberIds;
    }

    function isMember(hid) {
      return request.auth != null && request.auth.uid in householdMemberIds(hid);
    }

    function optString(data, key, max) {
      return !(key in data) || data[key] == null
        || (data[key] is string && data[key].size() <= max);
    }

    function optNumber(data, key) {
      return !(key in data) || data[key] == null || data[key] is number;
    }

    function optBool(data, key) {
      return !(key in data) || data[key] is bool;
    }

    // Type and length checks for the fields people edit on a household plant.
    function validHouseholdPlant(data) {
      return optString(data, 'custom_name', 100)
        && optString(data, 'custom_notes', 2000)
        && optString(data, 'location', 100)
        && optString(data, 'houseLocation', 100)
        && optString(data, 'plantId', 200)
        && optString(data, 'slug', 200)
        && optString(data, 'last_watered_by_name', 100)
        && optNumber(data, 'date_added')
        && optNumber(data, 'last_watered_date')
        && optNumber(data, 'next_watering_date')
        && optNumber(data, 'custom_watering_schedule')
        && optBool(data, 'reminders_enabled')
        && optBool(data, 'is_favorite')
        && optBool(data, 'shared')
        && (!('carerIds' in data) || data.carerIds is list && data.carerIds.size() <= 20)
        && (!('custom_attributes' in data) || data.custom_attributes is map);
    }

    // Fields only Cloud Functions write (reminder planning, see functions/reminders.js).
    function serverPlantKeys() {
      return ['notify_at', 'notify_stage', 'notify_for', 'notify_lease', 'notify_sending'];
    }

    // The fields logWatering writes (src/helpers/firebase/logWatering.ts).
    function wateringKeys() {
      return ['last_watered_date', 'next_watering_date', 'last_watered_by', 'last_watered_by_name'];
    }

    // The person who added a plant, or someone who looks after it.
    function isCarer(plant) {
      return plant.get('addedBy', null) == request.auth.uid
        || request.auth.uid in plant.get('carerIds', []);
    }

    match /Households/{hid} {
      // A user may check whether their own household exists yet; its ID is their uid.
      allow read: if (request.auth != null && hid == request.auth.uid && resource == null)
        || isMember(hid);
      // Anyone can create a household of their own. Members are added by the joinHousehold Cloud Function, never from the app.
      allow create: if request.auth != null
        && hid == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.createdBy == request.auth.uid;
      // Members can rename it, but not add or remove people.
      allow update: if isMember(hid)
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.members.keys().hasOnly(resource.data.members.keys())
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'members', 'timeZone']);
      allow delete: if false;

      // Create, update and delete are separate on purpose: rules that allow a
      // write are OR'd, so a blanket `allow write` would cancel these checks.
      match /Plants/{plantId} {
        allow read: if isMember(hid);
        allow create: if isMember(hid)
          && request.resource.data.addedBy == request.auth.uid
          && householdMemberIds(hid).hasAll(request.resource.data.get('carerIds', []))
          && !request.resource.data.keys().hasAny(serverPlantKeys())
          && validHouseholdPlant(request.resource.data);
        // The notify_* keys are set by Cloud Functions; addedBy never changes.
        // Who may do what to an existing plant:
        //  - its adder or a carer (isCarer): any edit, and delete;
        //  - any other member: only log a watering (wateringKeys), and only
        //    on a shared plant. They can also delete a shared plant.
        // A personal plant (shared == false) is its adder's and carers' alone.
        allow update: if isMember(hid)
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(serverPlantKeys().concat(['addedBy']))
          && householdMemberIds(hid).hasAll(request.resource.data.get('carerIds', []))
          && validHouseholdPlant(request.resource.data)
          && (isCarer(resource.data)
            || (resource.data.get('shared', false) == true
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(wateringKeys())));
        allow delete: if isMember(hid)
          && (isCarer(resource.data) || resource.data.get('shared', false) == true);
      }
    }

    // Base plants: shared catalog. Any authenticated user can read and
    // contribute a new plant, but existing shared plants cannot be edited
    // or deleted by clients.
    //
    // `create` requires a non-empty name (or scientific_name), only the
    // fields of IPlant, and sensible sizes, so the catalog can't be filled
    // with junk. All other writes are denied to clients.
    function optList(data, key, max) {
      return !(key in data) || (data[key] is list && data[key].size() <= max);
    }

    function validCatalogPlant(data, plantId) {
      return data.keys().hasOnly(['id', 'name', 'slug', 'scientific_name',
          'common_names', 'description', 'sun_requirements', 'watering_frequency',
          'fertilizer_needs', 'temperature_minimum', 'temperature_maximum',
          'humidity_requirements', 'growth_rate', 'pruning_needs',
          'pest_susceptibility', 'toxicity', 'images', 'growing_season',
          'mature_size', 'contributedBy', 'contributed_by', 'isVerified'])
        && (!('id' in data) || data.id == plantId)
        && (data.get('name', '') is string && data.get('name', '').size() > 0
          || data.get('scientific_name', []) is list && data.get('scientific_name', []).size() > 0)
        && optString(data, 'name', 200)
        && optString(data, 'slug', 200)
        && optString(data, 'description', 2000)
        && optString(data, 'sun_requirements', 500)
        && optString(data, 'fertilizer_needs', 500)
        && optString(data, 'humidity_requirements', 500)
        && optString(data, 'growth_rate', 200)
        && optString(data, 'pruning_needs', 500)
        && optString(data, 'toxicity', 500)
        && optString(data, 'growing_season', 200)
        && optString(data, 'mature_size', 200)
        && optString(data, 'contributedBy', 200)
        && optString(data, 'contributed_by', 200)
        && optNumber(data, 'watering_frequency')
        && optNumber(data, 'temperature_minimum')
        && optNumber(data, 'temperature_maximum')
        && data.get('isVerified', false) == false
        && optList(data, 'scientific_name', 10)
        && optList(data, 'common_names', 50)
        && optList(data, 'pest_susceptibility', 50)
        && optList(data, 'images', 20);
    }

    match /Plants/{plantId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && validCatalogPlant(request.resource.data, plantId);
      allow update, delete: if false;
    }

    // Invite codes. Written and read only by Cloud Functions.
    match /Invites/{code} {
      allow read, write: if false;
    }

    // Other collections not matched here (RateLimits, PushTickets) are closed to clients:
    // Firestore denies anything no rule allows.

    // Anonymised plants kept after account deletion. Written only by the
    // deleteAccount Cloud Function (Admin SDK); no client access.
    match /AnonymousPlants/{plantId} {
      allow read, write: if false;
    }
  }
}
