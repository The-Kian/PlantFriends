# .env.example

# Plant API Configuration

# Current (Perenual API)
# Get your key from: https://perenual.com/docs/api
PERENUAL_API_KEY=your_perenual_api_key_here

# Recommended Migration (Trefle API)
# Trefle offers better data coverage and a free tier
# Get your key from: https://trefle.io/users/sign_up
# Rate limits: 60 req/min (free), 600 req/min (GitHub sponsors)
# See docs/API_MIGRATION_GUIDE.md for migration steps
TREFLE_API_KEY=your_trefle_api_key_here

# Optional: Other API keys (if you add more services later)
# Sentry crash reporting (public DSN — safe to bundle; server token stays on CI)
# EXPO_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxx@o000000.ingest.sentry.io/0000000
# SENTRY_ORG=your-org
# SENTRY_PROJECT=plantfriends
# ANALYTICS_KEY=
