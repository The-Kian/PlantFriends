# .env.example — copy to .env for local development.
# Expo inlines EXPO_PUBLIC_* variables into the app bundle, so only put
# values here that are safe to ship to users. For EAS builds, set them with
# `eas env:create` instead.

# Google Sign-In: the *Web* OAuth client ID from the Firebase console
# (Authentication → Sign-in method → Google → Web SDK configuration).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# The Trefle API key is NOT set here. It lives only on the server as a
# Firebase secret: `firebase functions:secrets:set TREFLE_API_KEY`.
